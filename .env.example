# API Configuration
NEXT_PUBLIC_API_URL=https://your-api-url.com/api/admin

# Server Port (default: 3000)
PORT=3000

# GitHub GraphQL API (for giscus comments management)
# Get your token from: https://github.com/settings/tokens (needs 'public_repo' scope)
NEXT_PUBLIC_GITHUB_TOKEN=ghp_your_token_here
NEXT_PUBLIC_GITHUB_REPO_OWNER=your_username
NEXT_PUBLIC_GITHUB_REPO_NAME=your_repo
NEXT_PUBLIC_GITHUB_CATEGORY_ID=DIC_your_category_id
